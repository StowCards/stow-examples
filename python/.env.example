# Copy to .env, fill in your key, then load it into your shell:
#   set -a; . ./.env; set +a
# The demo reads these from the environment; it never prints the key.

# Required. Create one in the console: Administration > API Keys.
STOW_API_KEY=stow_replace_with_your_key

# Optional. Defaults to production. Plain http:// is accepted only for localhost, 127.0.0.1, [::1],
# names ending in .localhost and host.docker.internal.
# STOW_BASE_URL=https://api.stow.cards/api/v1
