{
  "name": "@stowcards/sdk",
  "version": "1.0.0",
  "description": "Official Node.js SDK for the Stow Cards API: enrol members, manage their Apple and Google Wallet passes, adjust points, redeem rewards and verify webhooks.",
  "keywords": [
    "stow",
    "stow-cards",
    "loyalty",
    "rewards",
    "points",
    "apple-wallet",
    "google-wallet",
    "wallet-pass",
    "pkpass",
    "webhooks",
    "sdk",
    "api-client"
  ],
  "homepage": "https://github.com/StowCards/stow-examples/tree/main/node#readme",
  "bugs": {
    "url": "https://github.com/StowCards/stow-examples/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StowCards/stow-examples.git",
    "directory": "node"
  },
  "license": "Apache-2.0",
  "author": "Stow Cards <hello@stow.cards> (https://stow.cards)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "api:check": "api-extractor run",
    "api:update": "npm run build && api-extractor run --local",
    "check:package": "publint --strict && attw --pack .",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run api:check && npm run check:package",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
